PERPLEXITY_API_KEY=your_api_key_here

# Required in production: shared secret for /api/extract (send as X-API-Key)
EXTRACT_API_KEY=change-me-to-a-long-random-string

# Comma-separated allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000

# SEC EDGAR requires an identifying User-Agent with real contact info
SEC_USER_AGENT=AnyFactor your-name your-email@example.com

# Optional server bind (defaults are safe for local use)
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Seconds to cache the SEC company tickers / companyfacts maps
SEC_TICKER_CACHE_TTL=3600

# Parallelism (SEC fetch/parse and LLM extraction)
FETCH_WORKERS=4
LLM_WORKERS=2

# Passage retrieval for LLM fallback
RETRIEVE_LIMIT=5
RETRIEVE_MAX_CHARS=14000

# LLM: auto | perplexity | ollama
LLM_PROVIDER=auto
PERPLEXITY_MODEL=sonar-pro

# Optional local closed-document model (no API key)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
